# Elephant Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Server Configuration
# =============================================================================
ELEPHANT_HOST=127.0.0.1
ELEPHANT_PORT=3000
# MCP accepts loopback Host headers by default. Add deployment hostnames or
# host:port values (comma-separated) for non-local clients; do not use wildcards.
# MCP_ALLOWED_HOSTS=elephant.example.com,192.0.2.20:3000
# Optionally restrict exact browser origins, including their effective ports.
# Clients without Origin still work; list null explicitly only if required.
# MCP_ALLOWED_ORIGINS=https://app.example.com
RUST_LOG=info

# Policy registry path (optional)
# ELEPHANT_POLICY_REGISTRY=/etc/elephant/policies
# ELEPHANT_STRICT_MODE=false

# =============================================================================
# JWT Authentication
# =============================================================================
# Authenticated startup requires at least 32 random bytes. For example, generate
# a value with openssl rand -hex 32; keep it out of Git and shell history.
# JWT_SECRET=
# JWT_ALGORITHM=HS256  # Only HS256 is supported
# JWT_ISSUER=elephant-api
# JWT_AUDIENCE=elephant-client

# Set to true to skip authentication in development
# SKIP_AUTH=false

# =============================================================================
# SurrealDB Connection
# =============================================================================
SURREALDB_URL=ws://localhost:8000
SURREALDB_NAMESPACE=elephant
SURREALDB_DATABASE=main
SURREALDB_USER=root
SURREALDB_PASS=root
# Embedded SurrealDB engine deadlines, validated integer seconds (1-86400).
# Both default to 30; the shorter value bounds each query/transaction batch.
# SURREALDB_QUERY_TIMEOUT_SECS=30
# SURREALDB_TRANSACTION_TIMEOUT_SECS=30
# Remote servers require their own query deadline. Docker Compose applies this
# server-side duration independently of the client settings above.
# SURREAL_QUERY_TIMEOUT=30s

# =============================================================================
# Pipeline - Durable Work Queue
# =============================================================================
# Ingest, extraction and promotion run as durable work items.
# PIPELINE_WORK_QUEUE_ENABLED=true
# PIPELINE_WORK_QUEUE_POLL_INTERVAL=5
# PIPELINE_MAX_CONCURRENT=8
# PIPELINE_MAX_EXTRACT_CONCURRENT=4

# =============================================================================
# Pipeline - Embed Worker
# =============================================================================
# PIPELINE_EMBED_ENABLED=true
# PIPELINE_EMBED_POLL_INTERVAL=5
# PIPELINE_EMBED_BATCH_SIZE=100
# PIPELINE_EMBED_PROVIDER=fake
# PIPELINE_EMBED_MODEL=text-embedding-3-large
# PIPELINE_EMBED_DIMS=3072

# OpenAI API key (required for openai provider)
# OPENAI_API_KEY=sk-...

# =============================================================================
# Pipeline - Promote Worker
# =============================================================================
# PIPELINE_PROMOTE_ENABLED=true
# PIPELINE_PROMOTE_POLL_INTERVAL=5
# PIPELINE_PROMOTE_CONFIDENCE_THRESHOLD=0.90

# =============================================================================
# Pipeline - Retention Worker
# =============================================================================
# PIPELINE_RETENTION_ENABLED=true
# PIPELINE_RETENTION_POLL_INTERVAL=3600
# PIPELINE_RETENTION_DAYS=30

# Durable terminal work archival, independent of legacy hourly cleanup.
# Uses PIPELINE_RETENTION_DAYS (default 30); each pass bounds jobs and attempts.
PIPELINE_WORK_HISTORY_POLL_INTERVAL=60
PIPELINE_WORK_HISTORY_BATCH_SIZE=1000
