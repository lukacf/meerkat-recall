#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${REPO_CARGO_REPO_ROOT:-}" ]]; then
  repo_root="${REPO_CARGO_REPO_ROOT}"
else
  repo_root="$(cd "${script_dir}/.." && pwd)"
fi

workspace_root="${REPO_CARGO_WORKSPACE_ROOT:-${repo_root}/.}"

if [[ -n "${REPO_CARGO_GIT_COMMON_DIR:-}" ]]; then
  git_common_dir="${REPO_CARGO_GIT_COMMON_DIR}"
elif [[ -e "${repo_root}/.git" ]]; then
  git_common_dir="$(cd "${repo_root}" && git rev-parse --path-format=absolute --git-common-dir)"
else
  # A source archive has no Git metadata. Use its own absolute path, even
  # when it was extracted inside an unrelated Git checkout.
  git_common_dir="${repo_root}/.git"
fi

if [[ -n "${REPO_CARGO_WORKTREE_ROOT:-}" ]]; then
  worktree_root="${REPO_CARGO_WORKTREE_ROOT}"
else
  worktree_root="${repo_root}"
fi

default_cargo_home="${CARGO_HOME:-${HOME}/.cargo}"

hash_path() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum | cut -c1-10
    return
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | cut -c1-10
    return
  fi

  if command -v openssl >/dev/null 2>&1; then
    printf '%s' "$1" | openssl dgst -sha256 -r | cut -d' ' -f1 | cut -c1-10
    return
  fi

  if command -v python3 >/dev/null 2>&1; then
    python3 - "$1" <<'PY'
import hashlib
import sys

print(hashlib.sha256(sys.argv[1].encode("utf-8")).hexdigest()[:10])
PY
    return
  fi

  echo "error: unable to hash paths; install shasum, sha256sum, openssl, or python3" >&2
  exit 1
}

prepend_unique_colon_path() {
  local var_name="$1"
  local entry="$2"
  local current="${!var_name:-}"

  [[ -n "${entry}" ]] || return 0
  [[ -d "${entry}" ]] || return 0

  case ":${current}:" in
    *":${entry}:"*) ;;
    *)
      if [[ -n "${current}" ]]; then
        export "${var_name}=${entry}:${current}"
      else
        export "${var_name}=${entry}"
      fi
      ;;
  esac
}

version_gt() {
  local lhs="$1"
  local rhs="$2"
  local IFS=.
  local -a left_parts right_parts
  local idx max_len

  read -r -a left_parts <<< "${lhs}"
  read -r -a right_parts <<< "${rhs}"
  max_len="${#left_parts[@]}"
  if (( ${#right_parts[@]} > max_len )); then
    max_len="${#right_parts[@]}"
  fi

  for (( idx=0; idx<max_len; idx++ )); do
    local left_part="${left_parts[idx]:-0}"
    local right_part="${right_parts[idx]:-0}"
    if (( 10#${left_part} > 10#${right_part} )); then
      return 0
    fi
    if (( 10#${left_part} < 10#${right_part} )); then
      return 1
    fi
  done

  return 1
}

latest_clang_runtime_dir() {
  local clang_root="$1"
  local best_dir=""
  local best_version=""
  local candidate_dir candidate_version

  while IFS= read -r candidate_dir; do
    candidate_version="$(basename "$(dirname "$(dirname "${candidate_dir}")")")"
    if [[ -z "${best_dir}" ]] || version_gt "${candidate_version}" "${best_version}"; then
      best_dir="${candidate_dir}"
      best_version="${candidate_version}"
    fi
  done < <(find "${clang_root}" -maxdepth 2 -type d -path '*/lib/darwin' 2>/dev/null)

  printf '%s' "${best_dir}"
}

repo_slug="$(basename "${repo_root}")"
repo_key="${repo_slug}-$(hash_path "${git_common_dir}")"

if [[ -n "${RUST_LANE_ID:-}" ]]; then
  lane_key="${RUST_LANE_ID}"
else
  worktree_name="$(basename "${worktree_root}")"
  lane_key="${worktree_name}-$(hash_path "${worktree_root}")"
fi

if [[ "$(uname -s)" == "Darwin" ]]; then
  cache_root="${HOME}/Library/Caches/rust-workspaces"

  developer_dir="$(xcode-select -p 2>/dev/null || true)"
  clang_root="${developer_dir}/Toolchains/XcodeDefault.xctoolchain/usr/lib/clang"
  if [[ -z "${CC:-}" ]]; then
    xcrun_clang="$(xcrun -f clang 2>/dev/null || true)"
    if [[ -n "${xcrun_clang}" ]]; then
      export CC="${xcrun_clang}"
    fi
  fi
  if [[ -z "${CXX:-}" ]]; then
    xcrun_clangxx="$(xcrun -f clang++ 2>/dev/null || true)"
    if [[ -n "${xcrun_clangxx}" ]]; then
      export CXX="${xcrun_clangxx}"
    fi
  fi
  if [[ -d "${clang_root}" ]]; then
    clang_runtime_dir="$(latest_clang_runtime_dir "${clang_root}")"
    if [[ -n "${clang_runtime_dir}" ]]; then
      prepend_unique_colon_path LIBRARY_PATH "${clang_runtime_dir}"
    fi
  fi
else
  cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}/rust-workspaces"
fi

export CARGO_HOME="${cache_root}/${repo_key}/cargo-home"
export CARGO_TARGET_DIR="${cache_root}/${repo_key}/targets/${lane_key}"
export REPO_CARGO_REPO_ROOT="${repo_root}"
export REPO_CARGO_WORKSPACE_ROOT="${workspace_root}"
export REPO_CARGO_GIT_COMMON_DIR="${git_common_dir}"
export REPO_CARGO_WORKTREE_ROOT="${worktree_root}"

mkdir -p "${CARGO_HOME}" "${CARGO_TARGET_DIR}"

for cargo_bin_dir in "${CARGO_HOME}/bin" "${default_cargo_home}/bin"; do
  [[ -d "${cargo_bin_dir}" ]] || continue
  case ":${PATH}:" in
    *":${cargo_bin_dir}:"*) ;;
    *) export PATH="${cargo_bin_dir}:${PATH}" ;;
  esac
done

if [[ "${1-}" == "--print-env" ]]; then
  cat <<EOF
repo_root=${repo_root}
workspace_root=${workspace_root}
repo_key=${repo_key}
lane_key=${lane_key}
CARGO_HOME=${CARGO_HOME}
CARGO_TARGET_DIR=${CARGO_TARGET_DIR}
REPO_CARGO_REPO_ROOT=${REPO_CARGO_REPO_ROOT}
EOF
  exit 0
fi

if [[ "${1-}" == "--doctor" ]]; then
  if [[ "${CARGO_HOME}" == "${repo_root}"* || "${CARGO_TARGET_DIR}" == "${repo_root}"* ]]; then
    echo "error: cache path resolved inside repo tree" >&2
    exit 1
  fi
  [[ -w "${CARGO_HOME}" ]] || { echo "error: CARGO_HOME not writable" >&2; exit 1; }
  [[ -w "${CARGO_TARGET_DIR}" ]] || { echo "error: CARGO_TARGET_DIR not writable" >&2; exit 1; }
  cat <<EOF
doctor=ok
repo_root=${repo_root}
workspace_root=${workspace_root}
repo_key=${repo_key}
lane_key=${lane_key}
CARGO_HOME=${CARGO_HOME}
CARGO_TARGET_DIR=${CARGO_TARGET_DIR}
REPO_CARGO_REPO_ROOT=${REPO_CARGO_REPO_ROOT}
EOF
  exit 0
fi

cd "${workspace_root}"
exec cargo "$@"
