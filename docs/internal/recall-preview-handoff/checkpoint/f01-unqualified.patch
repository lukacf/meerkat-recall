diff --git a/bin/elephant-api/src/runtime_access.rs b/bin/elephant-api/src/runtime_access.rs
new file mode 100644
index 0000000000000000000000000000000000000000..727fd3ef6214aee7c22d28552e28768d6ac67067
--- /dev/null
+++ b/bin/elephant-api/src/runtime_access.rs
@@ -0,0 +1,59 @@
+//! Runtime capability enforcement shared by the REST data routes.
+
+use std::sync::Arc;
+
+use axum::{
+    extract::{MatchedPath, Request, State},
+    http::{Method, StatusCode},
+    middleware::Next,
+    response::{IntoResponse, Response},
+    Json,
+};
+
+use crate::routes::entities::ApiError;
+use crate::runtime::{RuntimeManager, RuntimeMode};
+
+fn is_query(method: &Method, path: Option<&str>) -> bool {
+    if matches!(*method, Method::GET | Method::HEAD | Method::OPTIONS) {
+        return true;
+    }
+    *method == Method::POST
+        && matches!(
+            path,
+            Some(
+                "/v1/entities/search"
+                    | "/v1/entities/batch-get"
+                    | "/v1/relationships/search"
+                    | "/v1/timeline/search"
+                    | "/v1/assertions/search"
+                    | "/v1/docs/search"
+                    | "/v1/sources/search"
+                    | "/v1/system/snapshot/export"
+            )
+        )
+}
+
+pub(crate) async fn enforce_runtime_access(
+    State(runtime): State<Arc<RuntimeManager>>,
+    request: Request,
+    next: Next,
+) -> Response {
+    let path = request
+        .extensions()
+        .get::<MatchedPath>()
+        .map(MatchedPath::as_str);
+    if !is_query(request.method(), path)
+        && runtime.get_readiness().await.runtime_mode == RuntimeMode::ReadOnly
+    {
+        return (
+            StatusCode::FORBIDDEN,
+            Json(ApiError {
+                code: "RUNTIME_READ_ONLY".into(),
+                message: "This runtime permits queries only".into(),
+                details: None,
+            }),
+        )
+            .into_response();
+    }
+    next.run(request).await
+}
