    "failure": "no aggregate until every original input segment succeeds; malformed shape, nonfinite components, nonpositive byte weights, nonfinite sums/norm or zero norm refuse",
    "return_shape": "one final vector per original input, preserving original order; no cross-input pooling",
    "tolerance_after_f32_conversion": 1e-07
  },
