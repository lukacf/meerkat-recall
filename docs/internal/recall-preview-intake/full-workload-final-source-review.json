  "findings": [
    {
      "id": "I-FW-01",
      "severity": "source_custody_gap",
      "owner": [
        "integrity",
        "semantics"
      ],
      "locations": [
        "tests/recall_preview_semantics/full_workload_driver.py:241",
        "scripts/qualification/full_workload.py:23",
        "scripts/qualification/full_workload.py:140"
      ],
      "detail": "The driver reopens the OB3 oracle with SourceFileLoader. The CLI imports helper modules before separately hashing their on-disk files. The recorded seven-file inventory does not bind the exact executed original code bytes. Preserve verified original bytes for helper/oracle execution; do not bless a later filesystem or pyc read."
    },
    {
      "id": "I-FW-02",
      "severity": "runtime_prerequisite_not_satisfied_by_this_source",
      "owner": [
        "surface",
        "packaging",
        "qualification"
      ],
      "locations": [
        "scripts/qualification/full_workload.py:186",
        "scripts/qualification/full_workload.py:220"
      ],
      "detail": "Startup validation binds artifact/nonce/backend and workers_enabled, but does not consume or validate the actual effective worker concurrency/retry/embedding recipe required for FW09. The source package marks this prerequisite pending. Actual owner process evidence and independent expected values remain required before activation; a bool or spy idleness cannot supply them."
    },
    {
      "id": "I-FW-03",
      "severity": "declared_unmet_external_owner_seams",
      "owner": [
        "packaging",
        "qualification",
        "external_consumers"
      ],
      "locations": [
        "tests/recall_preview_semantics/full_workload_driver.py:619",
        "tests/recall_preview_semantics/full_workload_driver.py:1037",
        "scripts/qualification/full_workload.py:226"
      ],
      "detail": "The CLI does not supply capacity_capture or service_control. The driver explicitly records absent export capacity and always leaves external physical fallback/outage acceptance unmet. Existing optional callbacks and original receipt imports are not evidence that actual installed export/service-stop/consumer runs occurred."
    },
    {
      "id": "I-FW-04",
      "severity": "review_disposition_required",
      "owner": [
        "grounding",
        "qualification"
      ],
      "locations": [
        "tests/recall_preview_semantics/full_workload_load.py:48",
        "tests/recall_preview_semantics/full_workload_driver.py:399"
      ],
      "detail": "All 280 required same-space evidence results are strictly checked, but successful_response matches only each expected coverage member and does not reject extra coverage keys. This review does not treat that predicate as proof that no extraneous coverage key is exposed. D should decide exact-key enforcement against the frozen scoped response contract."
    }
  ],
