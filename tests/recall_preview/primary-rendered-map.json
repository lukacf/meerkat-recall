    {
      "space": "semantics-business",
      "source_key": "business/incident",
      "revision": "incident-r1",
      "input_sha256": "51755fb920ef87535ebc134d8e9dd2398f2d1796d145a0fa50f7915326f494b0",
      "input_utf8_bytes": 164,
      "rendered_text": "At 13:10 UTC on 6 May 2027, monitoring detected a failed backup. Service remained available. Recovery completed at 13:42 UTC; the incident was not a service outage.\n",
      "rendered_sha256": "471cba4b22bcc8790c634db6cbbde118f7639a931fc5addae248482206f03e7a",
