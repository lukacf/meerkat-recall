ELEPHANT_HOST=127.0.0.1
ELEPHANT_PORT=3000
ELEPHANT_DB=surreal-db
SURREALDB_URL=rocksdb:///var/lib/meerkat-recall/data/store
SURREALDB_NAMESPACE=recall
SURREALDB_DATABASE=main
ELEPHANT_SNAPSHOT_DIR=/var/lib/meerkat-recall/backups
ELEPHANT_DURABILITY_PATH=/var/lib/meerkat-recall/recovery
JWT_SECRET_FILE=/var/lib/meerkat-recall/secrets/signing-key
JWT_ISSUER=recall-local
JWT_AUDIENCE=recall
PIPELINE_SKILLS_DIR=/opt/meerkat-recall/current/skills
FASTEMBED_CACHE_DIR=/var/lib/meerkat-recall/model-cache
RUST_LOG=info
