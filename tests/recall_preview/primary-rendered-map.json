    {
      "space": "semantics-business",
      "source_key": "business/negation",
      "revision": "negation-r1",
      "input_sha256": "70b18030c16a4577538c465efba6638e9bd3711e8aaf5863a27abc23a01adc8b",
      "input_utf8_bytes": 131,
      "rendered_text": "The acquisition of Moss Ltd was discussed but never approved. No acquisition agreement was signed and Moss Ltd remains independent.\n",
      "rendered_sha256": "56da317eee3c6c93999e633341aa0473660532b8d3ac2bf24f2f3744e234fd15",
