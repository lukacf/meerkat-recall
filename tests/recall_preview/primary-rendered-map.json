    {
      "space": "semantics-business",
      "source_key": "business/launch",
      "revision": "launch-r1",
      "input_sha256": "b515d621b3c48e2cfc450bb31e4e18a27ad3cb7ff24949c41099257b7aa681fe",
      "input_utf8_bytes": 155,
      "rendered_text": "Project Lantern's production release is blocked until the independent accessibility audit passes. The pilot on 4 February 2027 is not a production release.\n",
      "rendered_sha256": "97fcfb4dee0c1eb1c023b65d1a2a3d45b0920b2fc674c21bcb8e44254c6d5d8d",
