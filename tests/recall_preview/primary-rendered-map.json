      "input_sha256": "13c0bfbe79c1d00d923fabdacf93152e60e4de012aa26d46d7919dc6f11a3850",
      "input_utf8_bytes": 160,
      "rendered_text": "Leena is the incident coordinator through 31 March 2027. Omar takes over effective 1 April 2027. This changes coordination responsibility, not system ownership.\n",
      "rendered_sha256": "b6c9d48d672737793ed68763fff72048348d45811b93efe687bdc615bc78f6de",
